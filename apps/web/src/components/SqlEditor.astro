---
import type { Migration, MigrationDiff } from "@/lib/api";

interface Props {
	connectionId: string;
	canEdit: boolean;
	csrf: string;
	migrations: Migration[];
	migrationsError: string | null;
	editMigrationId: number;
	diffId: number;
	diff: MigrationDiff | null;
	diffError: string | null;
	tableKey: string;
}

const { connectionId, canEdit, csrf, migrations, migrationsError, editMigrationId, diffId, diff, diffError, tableKey } =
	Astro.props;

const link = (extra: Record<string, string>) => {
	const params = new URLSearchParams({ tab: "sql", table: tableKey, ...extra });
	return `/databases/${connectionId}?${params.toString()}`;
};
// Astro action posts drop the current query string; re-attach it so the
// POST lands back on the SQL tab (and any open editor/diff) preserved.
const actionUrl = (name: string) => {
	const params = new URLSearchParams({ tab: "sql", table: tableKey });
	params.set("_action", name);
	return `?${params.toString()}`;
};
const statusClass = (status: string) =>
	status === "success"
		? "border-ok/40 bg-ok/10 text-ok"
		: status === "failed"
			? "border-error/40 bg-error/10 text-error"
			: "border-warning/40 bg-warning/10 text-warning";
---

<script>
	import "@/scripts/sql-editor";
	import type { ExplainNode, ExplainResult } from "@/lib/api";

	const escapeHtml = (value: unknown) =>
		String(value).replace(
			/[&<>"']/g,
			(char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char,
		);

	// Render one plan node with its scan/index/join details, planner estimates,
	// and — when ANALYZE ran — actual timings and row counts.
	const renderNode = (node: ExplainNode): string => {
		const label = [`<span class="font-semibold text-brass-lit">${escapeHtml(node.node_type)}</span>`];
		if (node.relation) label.push(`on <span class="text-foreground">${escapeHtml(node.relation)}</span>`);
		if (node.alias && node.alias !== node.relation) label.push(`<span class="text-dim">(${escapeHtml(node.alias)})</span>`);
		if (node.index) label.push(`using <span class="text-foreground">${escapeHtml(node.index)}</span>`);
		if (node.join_type) label.push(`<span class="text-dim">[${escapeHtml(node.join_type)}]</span>`);
		const estimate = `cost ${node.startup_cost.toFixed(2)}..${node.total_cost.toFixed(2)} · rows ${node.plan_rows} · width ${node.plan_width}`;
		const actual =
			node.actual_total_time === null || node.actual_total_time === undefined
				? ""
				: ` · <span class="text-ok">actual ${(node.actual_startup_time ?? 0).toFixed(3)}..${node.actual_total_time.toFixed(3)} ms · rows ${node.actual_rows ?? "?"} · loops ${node.actual_loops ?? "?"}</span>`;
		const details: string[] = [];
		if (node.index_cond) details.push(`Index Cond: ${escapeHtml(node.index_cond)}`);
		if (node.filter) details.push(`Filter: ${escapeHtml(node.filter)}`);
		if (node.sort_key?.length) details.push(`Sort Key: ${escapeHtml(node.sort_key.join(", "))}`);
		const children = (node.children ?? []).map(renderNode).join("");
		return `<div class="border-l border-seam pl-3">
			<div>${label.join(" ")}</div>
			<div class="text-dim">${estimate}${actual}</div>
			${details.length ? `<div class="text-dim">${details.join(" · ")}</div>` : ""}
			${children ? `<div class="mt-1 space-y-1">${children}</div>` : ""}
		</div>`;
	};

	const renderExplain = (body: ExplainResult): string => {
		if (body.nodes?.length) {
			return `<div class="mono space-y-2 text-xs">${body.nodes.map(renderNode).join("")}</div>`;
		}
		const columns = body.columns ?? [];
		const rows = body.rows ?? [];
		if (columns.length === 0) {
			return "<p class='text-sm text-dim'>No plan returned.</p>";
		}
		const head = columns.map((name) => `<th class="mono px-3 py-2 font-semibold">${escapeHtml(name)}</th>`).join("");
		const bodyRows = rows
			.map(
				(row) =>
					`<tr>${row
						.map((value) => `<td class="mono max-w-xs truncate px-3 py-2">${value === null ? "NULL" : escapeHtml(value)}</td>`)
						.join("")}</tr>`,
			)
			.join("");
		return `<table class="w-full text-left text-xs"><thead class="bg-plate-raised text-dim"><tr>${head}</tr></thead><tbody class="divide-y divide-seam">${bodyRows}</tbody></table>`;
	};

	const explainError = (message: string) =>
		`<div class='border border-error/40 bg-error/10 px-4 py-3 text-sm text-error'>${escapeHtml(message)}</div>`;

	// Ad-hoc read-only runner: submits the CodeMirror-backed textarea through
	// the existing read-only query endpoint and renders the result table.
	const runnerForm = document.getElementById("runner-form") as HTMLFormElement | null;
	const runnerOutput = document.getElementById("runner-output");
	runnerForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!runnerOutput) return;
		const sql = (runnerForm.elements.namedItem("sql") as HTMLTextAreaElement).value;
		const connection = runnerForm.dataset.connection ?? "";
		const csrfToken = runnerForm.dataset.csrf ?? "";
		const mode = (event as SubmitEvent).submitter instanceof HTMLButtonElement
			? ((event as SubmitEvent).submitter as HTMLButtonElement).dataset.mode ?? "run"
			: "run";
		if (mode !== "run") {
			const analyze = mode === "explain-analyze";
			runnerOutput.innerHTML = `<p class='text-sm text-dim'>${analyze ? "Running EXPLAIN ANALYZE…" : "Planning…"}</p>`;
			try {
				const response = await fetch(`/api/databases/${connection}/explain`, {
					method: "POST",
					headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
					body: JSON.stringify({ sql, analyze }),
				});
				const body = await response.json();
				if (!response.ok) {
					runnerOutput.innerHTML = explainError(body?.error?.message ?? "Explain failed");
					return;
				}
				runnerOutput.innerHTML = renderExplain(body as ExplainResult);
			} catch {
				runnerOutput.innerHTML = explainError("Explain failed.");
			}
			return;
		}
		runnerOutput.innerHTML = "<p class='text-sm text-dim'>Running…</p>";
		try {
			const response = await fetch(`/api/databases/${connection}/query`, {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
				body: JSON.stringify({ sql, limit: 10000 }),
			});
			const body = await response.json();
			if (!response.ok) {
				runnerOutput.innerHTML = explainError(body?.error?.message ?? "Query failed");
				return;
			}
			const columns: string[] = body.columns ?? [];
			const rows: unknown[][] = body.rows ?? [];
			if (columns.length === 0) {
				runnerOutput.innerHTML = "<p class='text-sm text-dim'>No result set.</p>";
				return;
			}
			const head = columns.map((name) => `<th class="mono px-3 py-2 font-semibold">${escapeHtml(name)}</th>`).join("");
			const bodyRows = rows
				.map(
					(row) =>
						`<tr>${row
							.map((value) => `<td class="mono max-w-xs truncate px-3 py-2">${value === null ? "NULL" : escapeHtml(value)}</td>`)
							.join("")}</tr>`,
				)
				.join("");
			runnerOutput.innerHTML = `<table class="w-full text-left text-xs"><thead class="bg-plate-raised text-dim"><tr>${head}</tr></thead><tbody class="divide-y divide-seam">${bodyRows}</tbody></table>`;
		} catch {
			runnerOutput.innerHTML = explainError("Query failed.");
		}
	});

	// Pending migrations can be planned before execution. When the inline
	// editor is open its textarea wins over the stored SQL.
	document.querySelectorAll<HTMLButtonElement>("button[data-explain]").forEach((button) => {
		button.addEventListener("click", async () => {
			const block = button.closest<HTMLElement>("[data-migration]");
			const output = block?.querySelector<HTMLElement>(".explain-output");
			if (!block || !output) return;
			const sql = block.querySelector<HTMLTextAreaElement>("textarea[name='sql']")?.value ?? block.dataset.sql ?? "";
			if (!sql.trim()) {
				output.classList.remove("hidden");
				output.innerHTML = explainError("SQL is empty.");
				return;
			}
			const analyze = button.dataset.analyze === "true";
			output.classList.remove("hidden");
			output.innerHTML = `<p class='text-sm text-dim'>${analyze ? "Running EXPLAIN ANALYZE…" : "Planning…"}</p>`;
			try {
				const response = await fetch(`/api/databases/${block.dataset.connection}/explain`, {
					method: "POST",
					headers: { "Content-Type": "application/json", "X-CSRF-Token": block.dataset.csrf ?? "" },
					body: JSON.stringify({ sql, analyze }),
				});
				const body = await response.json();
				output.innerHTML = response.ok
					? renderExplain(body as ExplainResult)
					: explainError(body?.error?.message ?? "Explain failed");
			} catch {
				output.innerHTML = explainError("Explain failed.");
			}
		});
	});

	// Delete confirmations on destructive migration actions.
	document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
		form.addEventListener("submit", (event) => {
			if (!confirm(form.dataset.confirm ?? "Are you sure?")) event.preventDefault();
		});
	});
</script>

<div class="space-y-4">
	{migrationsError && (
		<div class="border border-error/40 bg-error/10 px-4 py-3 text-sm text-error">{migrationsError}</div>
	)}

	{canEdit && (
		<form method="POST" action={actionUrl("createMigration")} class="panel p-4">
			<input type="hidden" name="csrf_token" value={csrf} />
			<input type="hidden" name="id" value={connectionId} />
			<label class="block">
				<span class="mb-1 block text-sm text-dim">New migration SQL</span>
				<textarea name="sql" required rows="6" class="mono field w-full sql-editor" placeholder="CREATE TABLE notes (id serial PRIMARY KEY, body text);"></textarea>
			</label>
			<button type="submit" class="btn-brass mt-3 px-3 py-2 text-xs">Create migration</button>
		</form>
	)}

	<section class="panel">
		<div class="nameplate">Runner (read-only)</div>
		<div class="p-4">
			<form id="runner-form" data-connection={connectionId} data-csrf={csrf} class="grid gap-3">
				<textarea name="sql" rows="4" required class="mono field w-full sql-editor" placeholder="SELECT * FROM notes LIMIT 5;"></textarea>
				<div class="flex flex-wrap items-center gap-2">
					<button type="submit" data-mode="run" class="btn-brass px-3 py-2 text-xs">Run query</button>
					<button type="submit" data-mode="explain" class="border border-seam px-3 py-2 text-xs text-brass-lit hover:border-brass">
						Explain
					</button>
					<button type="submit" data-mode="explain-analyze" class="border border-seam px-3 py-2 text-xs text-brass-lit hover:border-brass">
						Explain Analyze
					</button>
					<span class="text-xs text-dim">EXPLAIN ANALYZE runs inside a read-only transaction; results are discarded.</span>
				</div>
			</form>
			<div id="runner-output" class="mt-3 overflow-x-auto"></div>
		</div>
	</section>

	<section class="panel overflow-hidden">
		<div class="nameplate">Migrations</div>
		<div class="p-4">
			{migrations.length === 0 ? (
				<p class="text-sm text-dim">No migrations recorded for this database.</p>
			) : (
				<div class="space-y-2">
					{migrations.map((migration) => (
						<div
							class="border border-seam bg-zinc-950"
							data-migration={migration.id}
							data-sql={migration.sql}
							data-connection={connectionId}
							data-csrf={csrf}
						>
							<div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
								<div class="flex items-center gap-2 text-xs">
									<span class="mono font-bold">v{migration.version}</span>
									<span class={`border px-2 py-1 ${statusClass(migration.status)}`}>{migration.status}</span>
									<span class="text-dim">{migration.executor_username || `#${migration.executor_id}`}</span>
									{migration.status !== "pending" && <span class="mono text-dim">{migration.executed_at}</span>}
								</div>
								<div class="flex items-center gap-2">
									{migration.status === "success" && (
										<a href={link({ diff: String(migration.id) })} class="text-xs text-dim underline hover:text-foreground">
											View diff
										</a>
									)}
									{canEdit && migration.status !== "success" && (
										<>
											{migration.status === "pending" && (
												<form method="POST" action={actionUrl("executeMigration")} class="inline">
													<input type="hidden" name="csrf_token" value={csrf} />
													<input type="hidden" name="id" value={connectionId} />
													<input type="hidden" name="migration_id" value={migration.id} />
													<button type="submit" class="text-xs text-brass-lit hover:underline">Execute</button>
												</form>
											)}
											<a href={editMigrationId === migration.id ? link({}) : link({ edit: String(migration.id) })} class="text-xs text-dim underline hover:text-foreground">
												{editMigrationId === migration.id ? "Close editor" : migration.status === "failed" ? "Fix" : "Edit"}
											</a>
										</>
									)}
								</div>
							</div>
							<div class="px-3 pb-3">
								{canEdit && editMigrationId === migration.id && migration.status !== "success" ? (
									<form method="POST" action={actionUrl("updateMigration")} class="grid gap-2">
										<input type="hidden" name="csrf_token" value={csrf} />
										<input type="hidden" name="id" value={connectionId} />
										<input type="hidden" name="migration_id" value={migration.id} />
										<textarea name="sql" required rows="6" class="mono field w-full sql-editor">{migration.sql}</textarea>
										<div class="flex items-center gap-2">
											<button type="submit" class="btn-brass px-2 py-1 text-xs">Save</button>
											<a href={link({})} class="px-2 py-1 text-xs text-dim underline">Cancel</a>
										</div>
									</form>
								) : (
									<pre class="mono max-h-40 overflow-auto whitespace-pre-wrap text-xs text-dim">{migration.sql}</pre>
								)}
								{canEdit && migration.status === "pending" && (
									<div class="mt-2 flex flex-wrap items-center gap-2 border-t border-seam pt-2">
										<span class="text-xs text-dim">Execution plan:</span>
										<button type="button" data-explain data-analyze="false" class="text-xs text-brass-lit hover:underline">
											Explain
										</button>
										<button type="button" data-explain data-analyze="true" class="text-xs text-brass-lit hover:underline">
											Explain Analyze
										</button>
										<span class="text-xs text-dim">Only SELECT/WITH statements can be planned; DDL executes without a plan.</span>
									</div>
								)}
								<div class="explain-output mt-2 hidden"></div>
							</div>
							{diffId === migration.id && (
								<div class="border-t border-seam px-3 py-3">
									<div class="mb-2 text-xs font-bold">Schema diff {migration.status === "success" ? "(before → after)" : ""}</div>
									{diffError && <div class="text-sm text-error">{diffError}</div>}
									{diff && diff.changes.length === 0 && <p class="text-sm text-dim">No schema changes recorded.</p>}
									{diff && diff.changes.length > 0 && (
										<ul class="mono space-y-1 text-xs">
											{diff.changes.map((change) => (
												<li>
													<span
														class={`mr-2 inline-block w-14 text-center ${
															change.action === "added"
																? "text-ok"
																: change.action === "removed"
																	? "text-error"
																	: "text-warning"
														}`}
													>
														{change.action}
													</span>
													<span class="text-foreground">{change.object_type}</span> {change.object_id}
													{change.detail && <span class="text-dim"> — {change.detail}</span>}
												</li>
											))}
										</ul>
									)}
									{diff && diff.status !== "success" && (
										<p class="text-sm text-dim">Diff is only available for executed migrations.</p>
									)}
								</div>
							)}
						</div>
					))}
				</div>
			)}
		</div>
	</section>
</div>
