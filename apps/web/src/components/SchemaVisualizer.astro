---
import type { DatabaseSchema } from "@/lib/api";

interface Props {
	schema: DatabaseSchema;
}

const { schema } = Astro.props;

// Server-rendered schema visualizer: table boxes on a deterministic grid with
// FK connectors drawn above the boxes. Hovering an edge or a table highlights
// the edge and both of its tables (client script below).

// Postgres reports verbose type names; abbreviate so columns fit the box.
const TYPE_ABBREV: Record<string, string> = {
	"character varying": "varchar",
	"timestamp with time zone": "timestamptz",
	"timestamp without time zone": "timestamp",
	"double precision": "float8",
	"bit varying": "varbit",
};

const BOX_W = 260;
const COL_H = 22;
const HEADER_H = 30;
const PAD = 16;
const GAP_X = 90;
const GAP_Y = 28;
const PER_ROW = 3;

interface Placed {
	name: string;
	schemaName: string;
	columns: { name: string; type: string; pk: boolean }[];
	x: number;
	y: number;
	w: number;
	h: number;
}

const tables = schema.schemas
	.flatMap((s) => s.tables.map((t) => ({ ...t, schemaName: s.schema })))
	.sort((a, b) => a.name.localeCompare(b.name));

const abbrev = (type: string) => TYPE_ABBREV[type] ?? type;

// Rows are laid out with the height of the tallest box in each row, so boxes
// never overlap vertically.
const placed: Placed[] = [];
let cursorY = 0;
for (let rowStart = 0; rowStart < tables.length; rowStart += PER_ROW) {
	const rowTables = tables.slice(rowStart, rowStart + PER_ROW);
	const heights = rowTables.map((t) => HEADER_H + t.columns.length * COL_H + PAD);
	const rowH = Math.max(...heights);
	rowTables.forEach((table, col) => {
		const pkColumns = new Set(
			(table.constraints ?? []).filter((c) => c.type === "PRIMARY KEY").flatMap((c) => c.columns),
		);
		placed.push({
			name: table.name,
			schemaName: table.schemaName,
			columns: table.columns.map((c) => ({ name: c.name, type: abbrev(c.type), pk: pkColumns.has(c.name) })),
			x: col * (BOX_W + GAP_X),
			y: cursorY,
			w: BOX_W,
			h: heights[col],
		});
	});
	cursorY += rowH + GAP_Y;
}

const positions = new Map(placed.map((p) => [`${p.schemaName}.${p.name}`, p]));

interface Edge {
	from: string;
	to: string;
	x1: number;
	y1: number;
	x2: number;
	y2: number;
}
const edges: Edge[] = [];
for (const table of placed) {
	for (const constraint of schema.schemas
		.flatMap((s) => s.tables)
		.find((t) => t.name === table.name)
		?.constraints ?? []) {
		if (constraint.type !== "FOREIGN KEY" || !constraint.referenced_table) continue;
		const fromKey = `${table.schemaName}.${table.name}`;
		const toKey = `${table.schemaName}.${constraint.referenced_table}`;
		const from = positions.get(fromKey);
		const to = positions.get(toKey);
		if (!from || !to || fromKey === toKey) continue;
		// Connect the facing sides of the two boxes.
		const rightwards = to.x > from.x;
		edges.push({
			from: fromKey,
			to: toKey,
			x1: rightwards ? from.x + from.w : from.x,
			y1: from.y + HEADER_H / 2,
			x2: rightwards ? to.x : to.x + to.w,
			y2: to.y + HEADER_H / 2,
		});
	}
}

const maxX = Math.max(...placed.map((p) => p.x + p.w), BOX_W);
const maxY = Math.max(cursorY - GAP_Y, 200);
const viewBox = `0 0 ${maxX + GAP_X} ${maxY + GAP_Y}`;
---

<div class="panel overflow-auto">
	<div class="nameplate">Schema Visualizer</div>
	<svg viewBox={viewBox} class="h-auto w-full min-w-[900px]" role="img" aria-label="Schema diagram">
		<defs>
			<marker id="fk-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
				<path d="M0,0 L8,3 L0,6 Z" fill="var(--accent)" />
			</marker>
		</defs>

		{placed.map((table) => (
			<g class="table-node" data-table={`${table.schemaName}.${table.name}`}>
				<rect x={table.x} y={table.y} width={table.w} height={table.h} rx="6" class="fill-surface stroke-border" stroke-width="1.5" />
				<text x={table.x + PAD / 2} y={table.y + 20} class="mono fill-current" font-size="13" font-weight="bold">
					{table.schemaName}.{table.name}
				</text>
				{table.columns.map((column, index) => (
					<text x={table.x + PAD / 2} y={table.y + HEADER_H + index * COL_H + 16} class="mono fill-current" font-size="11">
						{column.pk ? "🔑 " : ""}{column.name} : {column.type}
					</text>
				))}
			</g>
		))}

		{edges.map((edge) => (
			<line
				class="fk-edge"
				data-from={edge.from}
				data-to={edge.to}
				x1={edge.x1}
				y1={edge.y1}
				x2={edge.x2}
				y2={edge.y2}
				stroke="var(--accent)"
				stroke-width="1.5"
				opacity="0.7"
				marker-end="url(#fk-arrow)"
			/>
		))}
	</svg>
</div>

<style>
	.fk-edge:hover,
	.fk-edge.edge-active {
		stroke-width: 3.5;
		opacity: 1;
	}
</style>

<script>
	// Hover an edge → highlight it and both tables. Hover a table → highlight
	// every edge attached to it and the tables on the other end.
	function activateEdge(line: Element) {
		line.classList.add("edge-active");
		document
			.querySelectorAll(`.table-node[data-table="${line.getAttribute("data-from")}"]`)
			.forEach((node) => node.classList.add("edge-active"));
		document
			.querySelectorAll(`.table-node[data-table="${line.getAttribute("data-to")}"]`)
			.forEach((node) => node.classList.add("edge-active"));
	}
	function reset() {
		document.querySelectorAll(".edge-active").forEach((el) => el.classList.remove("edge-active"));
	}
	document.querySelectorAll<SVGLineElement>(".fk-edge").forEach((line) => {
		line.addEventListener("mouseenter", () => {
			reset();
			activateEdge(line);
		});
		line.addEventListener("mouseleave", reset);
	});
	document.querySelectorAll<SVGGElement>(".table-node").forEach((node) => {
		const key = node.getAttribute("data-table");
		if (!key) return;
		node.addEventListener("mouseenter", () => {
			reset();
			document.querySelectorAll(`.fk-edge[data-from="${key}"], .fk-edge[data-to="${key}"]`).forEach(activateEdge);
		});
		node.addEventListener("mouseleave", reset);
	});
</script>
