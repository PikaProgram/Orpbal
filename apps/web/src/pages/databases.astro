---
import Layout from "@/layouts/Layout.astro";
import { api, type MyDatabase } from "@/lib/api";
import { requireSession } from "@/lib/session";

const auth = await requireSession(Astro);
if (auth instanceof Response) return auth;

const result = await api<MyDatabase[]>("/me/databases", { cookie: auth.cookie });
const databases = result.data;
---

<Layout title="Databases" user={auth.session.user}>
	<h1 class="mb-2 text-2xl font-bold tracking-tight">Databases</h1>
	<p class="mb-6 max-w-2xl text-sm text-dim">
		Connections available through your groups. Effective access is the highest grant you hold.
	</p>

	{
		databases.length === 0 ? (
			<div class="panel p-6 text-sm text-dim">
				No database connections are available to your groups yet.
			</div>
		) : (
			<div class="panel overflow-hidden">
				<div class="nameplate">Connected lines</div>
				<table class="w-full text-left text-sm">
					<thead class="bg-plate-raised text-dim">
						<tr>
							<th class="px-4 py-3 font-semibold">Name</th>
							<th class="px-4 py-3 font-semibold">Host</th>
							<th class="px-4 py-3 font-semibold">Database</th>
							<th class="px-4 py-3 font-semibold">Access</th>
						</tr>
					</thead>
					<tbody class="divide-y-2 divide-seam bg-zinc-950">
						{databases.map((database) => (
							<tr>
								<td class="px-4 py-3 font-semibold">
								<a class="text-accent hover:underline" href={`/databases/${database.connection_id}`}>
									{database.name}
								</a>
							</td>
								<td class="mono px-4 py-3">{database.host}</td>
								<td class="mono px-4 py-3">{database.database_name}</td>
								<td class="px-4 py-3">
									{database.access_level === "view_edit" ? (
										<span class="border border-ok/40 bg-ok/10 px-2 py-1 text-xs text-ok">
											View + Edit
										</span>
									) : (
										<span class="border border-dim/40 bg-dim/10 px-2 py-1 text-xs text-dim">
											View Only
										</span>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}
</Layout>
