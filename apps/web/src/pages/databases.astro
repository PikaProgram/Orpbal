---
import Layout from "@/layouts/Layout.astro";
import { api, type MyDatabase } from "@/lib/api";
import { requireSession } from "@/lib/session";

const auth = await requireSession(Astro);
if (auth instanceof Response) return auth;

const result = await api<MyDatabase[]>("/me/databases", { cookie: auth.cookie });
const databases = result.data;
---

<Layout title="Databases" user={auth.session.user}>
	<h1 class="mb-2 text-2xl font-semibold tracking-tight">Databases</h1>
	<p class="mb-6 text-sm text-zinc-400">
		Connections available through your groups. Effective access is the highest grant you hold.
	</p>

	{
		databases.length === 0 ? (
			<p class="rounded-lg border border-zinc-800 bg-zinc-900 p-6 text-sm text-zinc-400">
				No database connections are available to your groups yet.
			</p>
		) : (
			<div class="overflow-hidden rounded-lg border border-zinc-800">
				<table class="w-full text-left text-sm">
					<thead class="bg-zinc-900 text-zinc-400">
						<tr>
							<th class="px-4 py-3 font-medium">Name</th>
							<th class="px-4 py-3 font-medium">Host</th>
							<th class="px-4 py-3 font-medium">Database</th>
							<th class="px-4 py-3 font-medium">Access</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-zinc-800 bg-zinc-950">
						{databases.map((database) => (
							<tr>
								<td class="px-4 py-3">{database.name}</td>
								<td class="px-4 py-3 text-zinc-400">{database.host}</td>
								<td class="px-4 py-3 text-zinc-400">{database.database_name}</td>
								<td class="px-4 py-3">
									<span class="rounded bg-zinc-800 px-2 py-1 text-xs">
										{database.access_level === "view_edit" ? "View + Edit" : "View Only"}
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}
</Layout>
