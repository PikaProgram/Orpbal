---
import { actions } from "astro:actions";

import Layout from "@/layouts/Layout.astro";
import { readSession } from "@/lib/session";

const result = Astro.getActionResult(actions.login);
if (result?.data?.ok) return Astro.redirect("/");
if (Astro.request.method === "GET") {
	const session = await readSession(Astro.cookies);
	if (session) return Astro.redirect("/");
}

const error =
	result?.data && result.data.ok === false
		? result.data.error
		: result?.error
			? "Check your username and password."
			: null;

const fieldClass = "field";
---

<Layout title="Sign in">
	<div class="mx-auto max-w-md">
		<div class="panel">
			<div class="nameplate">Operator sign-in</div>
			<div class="p-6">
				<h1 class="mb-2 text-2xl font-bold tracking-tight">Sign in</h1>
				<p class="mb-6 text-sm text-dim">Use the account created by a Platform Admin.</p>

				{
					error && (
						<p class="mb-4 border-2 border-alert/60 bg-alert/10 px-3 py-2 text-sm text-alert">
							{error}
						</p>
					)
				}

				<form method="POST" action={actions.login} class="space-y-4">
					<label class="block text-sm">
						<span class="mb-1 block text-dim">Username</span>
						<input name="username" autocomplete="username" required class={fieldClass} />
					</label>
					<label class="block text-sm">
						<span class="mb-1 block text-dim">Password</span>
						<input
							type="password"
							name="password"
							autocomplete="current-password"
							required
							class={fieldClass}
						/>
					</label>
					<button type="submit" class="btn-brass w-full px-4 py-2 text-sm">
						Sign in
					</button>
				</form>
			</div>
		</div>
	</div>
</Layout>
