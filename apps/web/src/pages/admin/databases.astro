---
import { actions } from "astro:actions";

import Layout from "@/layouts/Layout.astro";
import { api, type DatabaseConnection } from "@/lib/api";
import { actionResults } from "@/lib/forms";
import { requireAdmin } from "@/lib/session";

const auth = await requireAdmin(Astro);
if (auth instanceof Response) return auth;

const outcome = actionResults(Astro, [
	actions.createConnection,
	actions.updateConnection,
	actions.setConnectionEnabled,
]);
if (outcome.succeeded) return Astro.redirect("/admin/databases");

const connections = (await api<DatabaseConnection[]>("/admin/databases", { cookie: auth.cookie })).data;
const csrf = auth.session.csrf_token;
const engines = [
	{ value: "postgres", label: "PostgreSQL", port: 5432 },
	{ value: "mysql", label: "MySQL", port: 3306 },
];
const sslModes = ["disable", "require", "verify-ca", "verify-full"];
const inputClass =
	"field";
const buttonClass = "btn-brass px-3 py-1.5 text-xs";
const quietButtonClass = "btn-steel px-3 py-1.5 text-xs";
---

<Layout title="Connections" user={auth.session.user}>
	<h1 class="text-2xl font-semibold tracking-tight">Database connections</h1>
	<p class="mb-6 text-sm text-zinc-400">
		Managed targets (PostgreSQL and MySQL). Creating or enabling a connection verifies it first; the engine cannot be changed afterwards.
	</p>

	{
		outcome.error && (
			<p class="error-note">
				{outcome.error}
			</p>
		)
	}

	<form
		method="POST"
		action={actions.createConnection}
		class="mb-6 grid gap-3 panel p-4 sm:grid-cols-2 lg:grid-cols-4"
	>
		<input type="hidden" name="csrf_token" value={csrf} />
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Engine</span>
			<select id="connection-engine" name="engine" class={inputClass}>
				{engines.map((e) => <option value={e.value} data-port={e.port}>{e.label}</option>)}
			</select>
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Name</span>
			<input name="name" required class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Host</span>
			<input name="host" required class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Port</span>
			<input id="connection-port" name="port" type="number" min="1" max="65535" value="5432" required class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Database</span>
			<input name="database_name" required class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Username</span>
			<input name="username" required class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">Password</span>
			<input name="password" type="password" class={inputClass} />
		</label>
		<label class="block text-sm">
			<span class="mb-1 block text-zinc-400">SSL mode</span>
			<select name="ssl_mode" class={inputClass}>
				{sslModes.map((mode) => <option value={mode}>{mode}</option>)}
			</select>
		</label>
		<div class="flex items-end">
			<button type="submit" class={buttonClass}>Add connection</button>
		</div>
	</form>

	<div class="space-y-4">
		{connections.map((connection) => (
			<section class="panel p-4">
				<div class="mb-3 flex flex-wrap items-start justify-between gap-3">
					<div>
						<h2 class="text-lg font-medium">{connection.name}</h2>
						<p class="font-mono text-xs text-zinc-400">
							{connection.host}:{connection.port}/{connection.database_name} · {connection.username}
						</p>
					</div>
					<div class="flex items-center gap-2 text-xs">
						<span class={connection.is_enabled ? "text-emerald-400" : "text-zinc-500"}>
							{connection.is_enabled ? "Enabled" : "Disabled"}
						</span>
						<span class="uppercase text-zinc-500">{connection.engine}</span>
						<span class="text-zinc-500">SSL: {connection.ssl_mode}</span>
						<span class="text-zinc-500">{connection.has_password ? "Password stored" : "No password"}</span>
					</div>
				</div>

				<form method="POST" action={actions.setConnectionEnabled} class="mb-2">
					<input type="hidden" name="csrf_token" value={csrf} />
					<input type="hidden" name="id" value={connection.id} />
					<input type="hidden" name="enabled" value={connection.is_enabled ? "false" : "true"} />
					<button type="submit" class={quietButtonClass}>
						{connection.is_enabled ? "Disable" : "Enable"}
					</button>
				</form>

				<details class="border-t-2 border-seam pt-3">
					<summary class="cursor-pointer text-xs text-zinc-400">Edit connection</summary>
					<form method="POST" action={actions.updateConnection} class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
						<input type="hidden" name="csrf_token" value={csrf} />
						<input type="hidden" name="id" value={connection.id} />
						<input name="name" value={connection.name} required class={inputClass} />
						<input name="host" value={connection.host} required class={inputClass} />
						<input name="port" type="number" min="1" max="65535" value={connection.port} required class={inputClass} />
						<input name="database_name" value={connection.database_name} required class={inputClass} />
						<input name="username" value={connection.username} required class={inputClass} />
						<input name="password" type="password" placeholder="Leave blank to keep" class={inputClass} />
						<select name="ssl_mode" class={inputClass}>
							{sslModes.map((mode) => (
								<option value={mode} selected={mode === connection.ssl_mode}>
									{mode}
								</option>
							))}
						</select>
						<div class="flex items-end">
							<button type="submit" class={quietButtonClass}>Save changes</button>
						</div>
					</form>
				</details>
			</section>
		))}
		{connections.length === 0 && (
			<p class="panel p-6 text-sm text-zinc-400">
				No connections yet.
			</p>
		)}
	</div>
</Layout>

<script>
	// The API defaults the port per engine; mirror that in the create form.
	const engine = document.getElementById("connection-engine") as HTMLSelectElement | null;
	const port = document.getElementById("connection-port") as HTMLInputElement | null;
	if (engine && port) {
		for (const option of engine.querySelectorAll("option")) {
			if (option instanceof HTMLOptionElement && option.selected) {
				port.value = option.dataset.port ?? "5432";
			}
		}
		engine.addEventListener("change", () => {
			const selected = engine.selectedOptions[0];
			if (selected && !port.dataset.touched) {
				port.value = selected.dataset.port ?? "5432";
			}
		});
		port.addEventListener("input", () => {
			port.dataset.touched = "true";
		});
	}
</script>
