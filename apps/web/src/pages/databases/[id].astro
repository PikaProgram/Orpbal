---
import { actions } from "astro:actions";

import Layout from "@/layouts/Layout.astro";
import { actionResults } from "@/lib/forms";
import { api, type MyDatabase, type DatabaseSchema, type QueryResult, type Migration, type TableCount, type MigrationDiff } from "@/lib/api";
import { requireSession } from "@/lib/session";

import SchemaVisualizer from "@/components/SchemaVisualizer.astro";
import TablesList from "@/components/TablesList.astro";
import TableEditor from "@/components/TableEditor.astro";
import SqlEditor from "@/components/SqlEditor.astro";

const auth = await requireSession(Astro);
if (auth instanceof Response) return auth;

const outcome = actionResults(Astro, [
	actions.createMigration,
	actions.updateMigration,
	actions.executeMigration,
	actions.insertRow,
	actions.updateRow,
	actions.deleteRow,
]);
if (outcome.succeeded) {
	const redirect = new URL(Astro.url);
	redirect.searchParams.delete("_action");
	return Astro.redirect(redirect.pathname + redirect.search);
}

const connectionId = Astro.params.id ?? "";
const tab = Astro.url.searchParams.get("tab") ?? "schema";
const tableKey = Astro.url.searchParams.get("table") ?? "";
const editMigrationId = Number(Astro.url.searchParams.get("edit") ?? "");
const diffId = Number(Astro.url.searchParams.get("diff") ?? "");
const dataOffset = Math.max(0, Number(Astro.url.searchParams.get("offset") ?? "") || 0);
const tabs = [
	{ id: "schema", label: "Schema Visualizer" },
	{ id: "tables", label: "Tables" },
	{ id: "editor", label: "Table Editor" },
	{ id: "sql", label: "SQL Editor" },
];
const tabLink = (id: string) => `/databases/${connectionId}?tab=${id}`;

// Fetch the user's access list to resolve the connection and access level.
const mineResult = await api<MyDatabase[]>("/me/databases", { cookie: auth.cookie });
const mine = mineResult.status === 200 ? mineResult.data : [];
const database = mine.find((db) => String(db.connection_id) === connectionId);
const canEdit = database?.access_level === "view_edit";
const csrf = auth.session.csrf_token;

let schema: DatabaseSchema | null = null;
let error: string | null = null;
if (!database) {
	error = "Database not found or you do not have access to it.";
} else {
	const result = await api<DatabaseSchema>(`/databases/${connectionId}/schema`, { cookie: auth.cookie });
	if (result.status === 200) {
		schema = result.data;
	} else {
		error = "Failed to load schema: the database may be unreachable or access was denied.";
	}
}

// Tables tab: planner estimates for the list (exact counts are on-demand).
let counts: TableCount[] | null = null;
if (schema && tab === "tables") {
	const result = await api<TableCount[]>(`/databases/${connectionId}/table-counts`, { cookie: auth.cookie });
	counts = result.status === 200 ? result.data : null;
}

// Editor tab: resolve the selected table and fetch one page of rows.
const safe = (value: string) => /^[a-zA-Z_][a-zA-Z0-9_]*$/.test(value);
const [editorSchema, editorTable] = tableKey.split(".");
const editorKnown =
	schema !== null &&
	editorSchema !== undefined &&
	editorTable !== undefined &&
	safe(editorSchema) &&
	safe(editorTable) &&
	schema.schemas.some((s) => s.schema === editorSchema && s.tables.some((t) => t.name === editorTable));

let rows: QueryResult | null = null;
let rowsError: string | null = null;
if (tab === "editor" && editorKnown) {
	const result = await api<QueryResult>(`/databases/${connectionId}/query`, {
		method: "POST",
		cookie: auth.cookie,
		csrf,
		body: { sql: `SELECT * FROM "${editorSchema}"."${editorTable}"`, limit: 50, offset: dataOffset },
	});
	if (result.status === 200) {
		rows = result.data;
	} else {
		rowsError = "Failed to load rows for this table.";
	}
}

// SQL tab: migration history plus the requested diff.
let migrations: Migration[] = [];
let migrationsError: string | null = null;
let diff: MigrationDiff | null = null;
let diffError: string | null = null;
if (database && tab === "sql") {
	const result = await api<Migration[]>(`/databases/${connectionId}/migrations`, { cookie: auth.cookie });
	if (result.status === 200) {
		migrations = result.data;
	} else {
		migrationsError = "Failed to load migration history.";
	}
	if (diffId) {
		const diffResult = await api<MigrationDiff>(`/databases/${connectionId}/migrations/${diffId}/diff`, { cookie: auth.cookie });
		if (diffResult.status === 200) {
			diff = diffResult.data;
		} else {
			diffError = "Failed to load the schema diff for this migration.";
		}
	}
}

const accessLabel = database?.access_level === "view_edit" ? "View + Edit" : "View Only";
---

<Layout title={`${database?.name ?? "Database"} — Viewer`} user={auth.session.user}>
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<div>
			<h1 class="text-2xl font-bold tracking-tight">{database?.name ?? "Database"}</h1>
			<p class="mono text-sm text-dim">
				{database?.host} / {database?.database_name}
			</p>
		</div>
		<span
			class={`border px-2 py-1 text-xs ${
				database?.access_level === "view_edit"
					? "border-ok/40 bg-ok/10 text-ok"
					: "border-dim/40 bg-dim/10 text-dim"
			}`}
		>
			{accessLabel}
		</span>
	</div>

	{error && (
		<div class="mb-4 border border-error/40 bg-error/10 px-4 py-3 text-sm text-error">{error}</div>
	)}

	{outcome.error && (
		<div class="mb-4 border border-error/40 bg-error/10 px-4 py-3 text-sm text-error">{outcome.error}</div>
	)}

	{database && (
		<nav class="mb-4 flex flex-wrap gap-1 border-b border-seam">
			{tabs.map((entry) => (
				<a
					href={tabLink(entry.id)}
					class={`-mb-px border-b-2 px-3 py-2 text-sm ${
						tab === entry.id
							? "border-brass font-semibold text-brass-lit"
							: "border-transparent text-dim hover:text-foreground"
					}`}
				>
					{entry.label}
				</a>
			))}
		</nav>
	)}

	{
		database && schema && tab === "schema" && <SchemaVisualizer schema={schema} />
	}

	{database && schema && tab === "tables" && <TablesList schema={schema} connectionId={connectionId} counts={counts} csrf={csrf} />}

	{database && schema && tab === "editor" && (
		<div class="grid gap-4 lg:grid-cols-[260px_1fr]">
			<aside class="panel max-h-[70vh] overflow-auto p-3">
				<div class="nameplate mb-2">Tables</div>
				{schema.schemas.map((entry) => (
					<div class="mb-3">
						<div class="mono mb-1 text-xs font-bold text-brass-lit">{entry.schema}</div>
						<ul class="space-y-1">
							{entry.tables.map((table) => {
								const key = `${entry.schema}.${table.name}`;
								const active = key === tableKey;
								return (
									<li>
										<a
											href={`/databases/${connectionId}?tab=editor&table=${encodeURIComponent(key)}`}
											class={`mono block px-2 py-1 text-xs ${
												active ? "bg-brass/20 text-brass-lit" : "text-dim hover:text-foreground"
											}`}
										>
											{table.name}
										</a>
									</li>
								);
							})}
							{entry.tables.length === 0 && <li class="px-2 py-1 text-xs text-dim">No tables</li>}
						</ul>
					</div>
				))}
			</aside>
			<main class="min-w-0">
				{!editorKnown && <div class="panel p-6 text-sm text-dim">Pick a table from the list to browse its rows.</div>}
				{editorKnown && (
					<TableEditor
						schema={schema}
						connectionId={connectionId}
						tableKey={tableKey}
						canEdit={canEdit}
						csrf={csrf}
						rows={rows}
						rowsError={rowsError}
						offset={dataOffset}
					/>
				)}
			</main>
		</div>
	)}

	{database && tab === "sql" && (
		<SqlEditor
			connectionId={connectionId}
			canEdit={canEdit}
			csrf={csrf}
			migrations={migrations}
			migrationsError={migrationsError}
			editMigrationId={editMigrationId}
			diffId={diffId}
			diff={diff}
			diffError={diffError}
			tableKey={tableKey}
		/>
	)}
</Layout>
