# Application settings
APP_ENV=development
APP_ORIGIN=http://localhost:4321
HOST=0.0.0.0
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/Orpbal?sslmode=disable

# base64-encoded 32 bytes: openssl rand -base64 32
ORPBAL_ENCRYPTION_KEY=

ORPBAL_BOOTSTRAP_ADMIN_USERNAME=admin
ORPBAL_BOOTSTRAP_ADMIN_PASSWORD=Admin!23

# Logging level (production => JSON logs, required for OTLP log correlation)
LOG_LEVEL=debug

# Observability (bonus B2). Leave OTLP endpoint empty for local stdout tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=orpbal-server
# ORPBAL_METRICS_ADDR=:9090  # worker only
