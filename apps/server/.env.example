# Application settings
HOST=0.0.0.0
PORT=8080

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:3001

# Database settings (if using GORM, sqlc, Ent, Bun, or sqlx)
DATABASE_URL=app.db

# gRPC settings (if using gRPC)
GRPC_PORT=50051

# Logging level
LOG_LEVEL=debug

# Goth OAuth settings
OAUTH_CALLBACK_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAPI HTTP address
OPENAPI_ADDR=:8081
