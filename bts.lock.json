    "package.json": "{\n  \"name\": \"Orpbal\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.6.5\",\n      \"@cloudflare/workers-types\": \"^4.20260629.1\",\n      \"alchemy\": \"^0.93.12\",\n      \"@types/bun\": \"^1.4.2\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"turbo -F web dev\\\" \\\"turbo -F @Orpbal/infra dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"setup:server\": \"bash scripts/native/task-2.sh\",\n    \"check:server\": \"bash scripts/native/task-3.sh\",\n    \"test:server\": \"bash scripts/native/task-3.sh\",\n    \"setup:part:backend:go:gin\": \"bash scripts/native/task-2.sh\",\n    \"dev:part:backend:go:gin\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:go:gin\": \"bash scripts/native/task-3.sh\",\n    \"test:part:backend:go:gin\": \"bash scripts/native/task-3.sh\",\n    \"db:local\": \"turbo -F @Orpbal/db db:local\",\n    \"test\": \"bun run --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"^6.0.3\",\n    \"@Orpbal/config\": \"workspace:*\",\n    \"@cloudflare/workers-types\": \"catalog:\",\n    \"turbo\": \"2.10.11\",\n    \"@types/bun\": \"catalog:\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@Orpbal/env\": \"workspace:*\"\n  }\n}\n",
