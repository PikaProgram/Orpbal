{
  "name": "Orpbal",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"bun run --filter web dev\" \"bash scripts/native/task-1.sh\"",
    "build": "bun run --if-present --filter '*' build",
    "check-types": "bun run --if-present --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bash scripts/native/task-1.sh",
    "setup:server": "bash scripts/native/task-2.sh",
    "check:server": "bash scripts/native/task-3.sh",
    "test:server": "bash scripts/native/task-3.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "setup:part:backend:go:gin": "bash scripts/native/task-2.sh",
    "dev:part:backend:go:gin": "bash scripts/native/task-1.sh",
    "check:part:backend:go:gin": "bash scripts/native/task-3.sh",
    "test:part:backend:go:gin": "bash scripts/native/task-3.sh",
    "test": "bun run --filter web test"
  },
  "dependencies": {},
  "devDependencies": {
    "@Orpbal/config": "workspace:*",
    "@types/bun": "^1.4.4",
    "concurrently": "^10.0.6",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
